#!/usr/bin/python3
"""Portal-isolated output folder picker for Omaloom.

Uses xdg-desktop-portal's FileChooser portal instead of an in-process Qt/GTK
folder dialog, so dialog/backend crashes cannot abort Quickshell.  Successful
selections are printed as one JSON object: {"path":"/local/folder"}.  User
cancellation is silent and exits non-zero.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.parse
from typing import Any

PORTAL_BUS_NAME = "org.freedesktop.portal.Desktop"
PORTAL_OBJECT_PATH = "/org/freedesktop/portal/desktop"
FILE_CHOOSER_IFACE = "org.freedesktop.portal.FileChooser"
REQUEST_IFACE = "org.freedesktop.portal.Request"


class PickerError(RuntimeError):
    pass


def local_path_from_uri(uri: str) -> str:
    parsed = urllib.parse.urlparse(uri)
    if parsed.scheme != "file":
        raise PickerError(f"selected URI is not a local file path: {parsed.scheme or uri}")
    if parsed.netloc not in ("", "localhost"):
        raise PickerError(f"selected file URI is not local: {parsed.netloc}")
    path = urllib.parse.unquote(parsed.path)
    if not path.startswith("/"):
        raise PickerError("selected file URI did not contain an absolute path")
    return path


def first_selected_path(results: dict[str, Any]) -> str:
    uris = results.get("uris")
    if not isinstance(uris, (list, tuple)) or not uris:
        raise PickerError("portal returned no selected URI")
    uri = uris[0]
    if not isinstance(uri, str):
        raise PickerError("portal returned a non-string URI")
    return local_path_from_uri(uri)


def emit_path(path: str) -> None:
    print(json.dumps({"path": path}, ensure_ascii=False), flush=True)


def run_portal_picker(title: str, current_folder: str) -> int:
    try:
        import gi  # type: ignore

        gi.require_version("Gio", "2.0")
        gi.require_version("GLib", "2.0")
        from gi.repository import Gio, GLib  # type: ignore
    except Exception as exc:  # pragma: no cover - depends on host packages
        raise PickerError(f"Python Gio/GLib is unavailable: {exc}") from exc

    loop = GLib.MainLoop()
    state: dict[str, Any] = {"done": False, "exit": 1, "error": None}

    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    proxy = Gio.DBusProxy.new_sync(
        connection,
        Gio.DBusProxyFlags.NONE,
        None,
        PORTAL_BUS_NAME,
        PORTAL_OBJECT_PATH,
        FILE_CHOOSER_IFACE,
        None,
    )

    options: dict[str, Any] = {
        "directory": GLib.Variant("b", True),
        "modal": GLib.Variant("b", True),
    }
    if current_folder:
        options["current_folder"] = GLib.Variant("ay", current_folder.encode() + b"\0")

    handle_variant = proxy.call_sync(
        "OpenFile",
        GLib.Variant("(ssa{sv})", ("", title, options)),
        Gio.DBusCallFlags.NONE,
        -1,
        None,
    )
    handle = handle_variant.unpack()[0]

    def on_response(_conn, _sender, _path, _iface, _signal, params):
        response, raw_results = params.unpack()
        if response == 0:
            try:
                emit_path(first_selected_path(raw_results))
                state["exit"] = 0
            except Exception as exc:
                state["error"] = str(exc)
                state["exit"] = 2
        else:
            # 1 = cancelled, 2 = dismissed/other.  Keep cancellation silent.
            state["exit"] = 1
        state["done"] = True
        loop.quit()

    sub_id = connection.signal_subscribe(
        PORTAL_BUS_NAME,
        REQUEST_IFACE,
        "Response",
        handle,
        None,
        Gio.DBusSignalFlags.NONE,
        on_response,
    )
    try:
        loop.run()
    finally:
        connection.signal_unsubscribe(sub_id)

    if state["error"]:
        raise PickerError(str(state["error"]))
    return int(state["exit"])


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Pick an Omaloom output folder with xdg-desktop-portal")
    parser.add_argument("--title", default="Choose Omaloom output folder")
    parser.add_argument("--current", default="")
    parser.add_argument("--decode-uri", help=argparse.SUPPRESS)
    args = parser.parse_args(argv[1:])

    if args.decode_uri is not None:
        emit_path(local_path_from_uri(args.decode_uri))
        return 0

    try:
        return run_portal_picker(args.title, args.current)
    except PickerError as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False), file=sys.stderr, flush=True)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
