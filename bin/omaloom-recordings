#!/usr/bin/env python3
"""Saved recording discovery and desktop actions for Omaloom."""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys
from typing import Any


class RecordingError(RuntimeError):
    pass


def emit(obj: dict[str, Any], stream=sys.stdout) -> None:
    print(json.dumps(obj, ensure_ascii=False, sort_keys=True), file=stream, flush=True)


def recording_path(path_arg: str) -> pathlib.Path:
    path = pathlib.Path(path_arg).expanduser().resolve(strict=False)
    try:
        st = path.stat()
    except OSError as exc:
        raise RecordingError(f"recording does not exist: {path}") from exc
    if not path.is_file() or path.suffix.lower() != ".mp4":
        raise RecordingError(f"not an MP4 recording: {path}")
    return path


def list_recordings(directory_arg: str, limit: int) -> int:
    directory = pathlib.Path(directory_arg).expanduser().resolve(strict=False)
    if limit < 0:
        limit = 0
    if not directory.exists() or not directory.is_dir():
        emit({"recordings": []})
        return 0

    rows: list[tuple[float, str, pathlib.Path, os.stat_result]] = []
    try:
        for entry in directory.iterdir():
            try:
                if not entry.is_file() or entry.suffix.lower() != ".mp4":
                    continue
                st = entry.stat()
            except OSError:
                continue
            rows.append((st.st_mtime, entry.name, entry.resolve(strict=False), st))
    except OSError as exc:
        raise RecordingError(f"could not scan directory: {directory}: {exc}") from exc

    rows.sort(key=lambda row: (-row[0], row[1]))
    recordings = [
        {
            "path": str(path),
            "name": name,
            "modified": int(st.st_mtime),
            "size": int(st.st_size),
        }
        for _mtime, name, path, st in (rows if limit == 0 else rows[:limit])
    ]
    emit({"recordings": recordings})
    return 0


def run_command(argv: list[str]) -> None:
    try:
        subprocess.Popen(argv, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        raise RecordingError(f"failed to launch {argv[0]}: {exc}") from exc


def open_recording(path_arg: str) -> int:
    path = recording_path(path_arg)
    opener = os.environ.get("OMALOOM_OPEN_COMMAND") or shutil.which("xdg-open") or shutil.which("gio")
    if not opener:
        raise RecordingError("no desktop opener found")
    argv = [opener, str(path)] if pathlib.Path(opener).name != "gio" else [opener, "open", str(path)]
    run_command(argv)
    emit({"ok": True, "action": "open", "path": str(path)})
    return 0


def reveal_recording(path_arg: str) -> int:
    path = recording_path(path_arg)
    parent = path.parent
    # Prefer org.freedesktop.FileManager1 when available.
    gdbus = shutil.which("gdbus")
    if gdbus:
        uri = path.as_uri()
        proc = subprocess.run(
            [
                gdbus,
                "call",
                "--session",
                "--dest",
                "org.freedesktop.FileManager1",
                "--object-path",
                "/org/freedesktop/FileManager1",
                "--method",
                "org.freedesktop.FileManager1.ShowItems",
                "[" + repr(uri) + "]",
                "",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if proc.returncode == 0:
            emit({"ok": True, "action": "reveal", "path": str(path)})
            return 0

    opener = os.environ.get("OMALOOM_REVEAL_COMMAND") or shutil.which("xdg-open") or shutil.which("gio")
    if not opener:
        raise RecordingError("no file manager opener found")
    argv = [opener, str(parent)] if pathlib.Path(opener).name != "gio" else [opener, "open", str(parent)]
    run_command(argv)
    emit({"ok": True, "action": "reveal", "path": str(path)})
    return 0


def copy_path(path_arg: str) -> int:
    path = recording_path(path_arg)
    copier = os.environ.get("OMALOOM_COPY_COMMAND") or shutil.which("wl-copy")
    if not copier:
        raise RecordingError("wl-copy not found")
    try:
        subprocess.run([copier], input=str(path), text=True, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise RecordingError(f"failed to copy path: {exc}") from exc
    emit({"ok": True, "action": "copy-path", "path": str(path)})
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="List and act on Omaloom recordings")
    sub = parser.add_subparsers(dest="command", required=True)
    list_p = sub.add_parser("list")
    list_p.add_argument("--directory", required=True)
    list_p.add_argument("--limit", type=int, default=5, help="maximum rows; 0 returns all recordings")
    for name in ("open", "reveal", "copy-path"):
        p = sub.add_parser(name)
        p.add_argument("path")
    args = parser.parse_args(argv[1:])

    try:
        if args.command == "list":
            return list_recordings(args.directory, args.limit)
        if args.command == "open":
            return open_recording(args.path)
        if args.command == "reveal":
            return reveal_recording(args.path)
        if args.command == "copy-path":
            return copy_path(args.path)
    except RecordingError as exc:
        emit({"error": str(exc)}, stream=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
