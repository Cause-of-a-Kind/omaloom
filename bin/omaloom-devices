#!/usr/bin/python3
"""Device discovery and lightweight setup-preview helpers for Omaloom."""
from __future__ import annotations

import ctypes
import json
import math
import os
import pathlib
import re
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import time
from typing import Any

CONTROLLED_PATH = "/usr/local/bin:/usr/bin:/bin:/usr/share/omarchy/bin"
PR_SET_PDEATHSIG = 1
LIBC = ctypes.CDLL(None, use_errno=True)


def terminate_with_parent() -> None:
    """Ensure the long-lived FFmpeg meter cannot outlive this helper."""
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    if LIBC.prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0) != 0:
        os._exit(127)
    # Close the fork/prctl race if the parent exited before prctl completed.
    if os.getppid() == 1:
        os._exit(127)


def which(command: str) -> str | None:
    return shutil.which(command, path=CONTROLLED_PATH)


def emit(obj: Any) -> None:
    print(json.dumps(obj, sort_keys=True), flush=True)


def list_microphones() -> int:
    devices = [{"id": "default_input", "label": "Default microphone"}]
    pactl = which("pactl")
    if pactl:
        try:
            raw = subprocess.check_output(
                [pactl, "--format=json", "list", "sources"], text=True, stderr=subprocess.DEVNULL
            )
            for source in json.loads(raw):
                name = str(source.get("name", ""))
                if not name or name.endswith(".monitor"):
                    continue
                label = str(source.get("description") or name)
                devices.append({"id": name, "label": label})
        except Exception:
            pass
    emit(devices)
    return 0


def list_webcams() -> int:
    devices = []
    cmd = which("omarchy-capture-webcam-list")
    if cmd:
        try:
            raw = subprocess.check_output([cmd], text=True, stderr=subprocess.DEVNULL)
            for line in raw.splitlines():
                line = line.strip()
                if not line:
                    continue
                parts = line.split(None, 1)
                device = parts[0]
                if not device.startswith("/dev/video"):
                    continue
                label = parts[1].strip() if len(parts) > 1 else device
                devices.append({"id": device, "label": label})
        except Exception:
            pass
    if not devices:
        v4l = which("v4l2-ctl")
        if v4l:
            try:
                raw = subprocess.check_output([v4l, "--list-devices"], text=True, stderr=subprocess.DEVNULL)
                current = ""
                for line in raw.splitlines():
                    if line and not line.startswith("\t"):
                        current = line.rstrip(":")
                    elif line.strip().startswith("/dev/video"):
                        devices.append({"id": line.strip(), "label": current or line.strip()})
            except Exception:
                pass
    emit(devices)
    return 0


def same_device(path: str, fd_target: str, device_stat: os.stat_result) -> bool:
    if fd_target != path and not fd_target.startswith(path + " "):
        return False
    try:
        target_stat = os.stat(fd_target.split(" (deleted)", 1)[0])
    except OSError:
        return False
    return stat.S_ISCHR(target_stat.st_mode) and target_stat.st_rdev == device_stat.st_rdev


def process_uid(pid: int) -> int | None:
    try:
        with open(f"/proc/{pid}/status", "r", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("Uid:"):
                    return int(line.split()[1])
    except OSError:
        return None
    return None


def process_name(pid: int) -> str:
    try:
        return pathlib.Path(f"/proc/{pid}/comm").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def camera_availability(device: str, ignore_pids: set[int] | None = None, proc_root: pathlib.Path = pathlib.Path("/proc")) -> dict[str, Any]:
    if ignore_pids is None:
        ignore_pids = {os.getpid(), os.getppid()}
    result: dict[str, Any] = {"device": device, "available": False, "busy": True, "owners": []}
    if not device or not device.startswith("/dev/video"):
        result["error"] = "invalid camera device"
        return result
    try:
        device_path = os.path.realpath(device)
        st = os.stat(device_path)
        if not stat.S_ISCHR(st.st_mode):
            result["error"] = "camera device is not a character device"
            return result
    except OSError as exc:
        result["error"] = f"camera device unavailable: {exc.strerror or exc}"
        return result

    current_uid = os.getuid()
    owners: list[dict[str, Any]] = []
    for proc_dir in proc_root.iterdir():
        if not proc_dir.name.isdigit():
            continue
        pid = int(proc_dir.name)
        if pid in ignore_pids:
            continue
        if process_uid(pid) != current_uid:
            continue
        fd_dir = proc_dir / "fd"
        try:
            fds = list(fd_dir.iterdir())
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(fd)
            except OSError:
                continue
            if same_device(device_path, target, st):
                owners.append({"pid": pid, "name": process_name(pid)})
                break
    result["owners"] = owners
    result["busy"] = len(owners) > 0
    result["available"] = len(owners) == 0
    if owners:
        result["message"] = "Camera is in use by another application. Close it or choose a different camera."
    return result


def check_camera(device: str) -> int:
    emit(camera_availability(device))
    return 0


def meter_level(db_text: str) -> float:
    """Map FFmpeg RMS dB output onto the setup meter's perceptual range."""
    db = -90.0 if db_text in ("-inf", "inf") else float(db_text)
    # Keep quiet but real microphone activity visible. A -60 dB floor made
    # normal USB mic speech/noise collapse to zero and look frozen.
    level = max(0.0, min(1.0, (db + 72.0) / 60.0))
    return round(math.sqrt(level), 3)


def meter(device: str) -> int:
    """Stream levels from one FFmpeg process for the popup's lifetime."""
    ffmpeg = which("ffmpeg")
    if not ffmpeg:
        return 1
    if not device:
        device = "default_input"

    running = True

    def stop(_signum, _frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    # ametadata writes one machine-readable RMS line per audio frame to stdout.
    # Keep FFmpeg alive instead of paying process/device initialization costs
    # four times per second, then throttle JSON events to a smooth ~12.5 Hz.
    proc = subprocess.Popen(
        [
            ffmpeg,
            "-hide_banner",
            "-nostdin",
            "-f",
            "pulse",
            "-i",
            device,
            "-vn",
            "-af",
            "astats=metadata=1:reset=10,"
            "ametadata=print:key=lavfi.astats.Overall.RMS_level:file=-:direct=1",
            "-f",
            "null",
            "-",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        bufsize=0,
        preexec_fn=terminate_with_parent,
    )
    if proc.stdout is None:
        proc.terminate()
        return 1

    pattern = re.compile(r"^lavfi\.astats\.Overall\.RMS_level=(-?inf|-?\d+(?:\.\d+)?)$")
    selector = selectors.DefaultSelector()
    selector.register(proc.stdout, selectors.EVENT_READ)
    last_emit = 0.0
    peak = 0.0
    saw_sample = False
    buffered = b""
    try:
        while running and proc.poll() is None:
            events = selector.select(timeout=0.2)
            if not events:
                continue
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                break
            buffered += chunk
            lines = buffered.split(b"\n")
            buffered = lines.pop()
            for raw_line in lines:
                match = pattern.match(raw_line.decode("ascii", "replace").strip())
                if match:
                    peak = max(peak, meter_level(match.group(1)))
                    saw_sample = True
            now = time.monotonic()
            if saw_sample and now - last_emit >= 0.08:
                emit({"level": peak})
                peak = 0.0
                saw_sample = False
                last_emit = now
    finally:
        selector.close()
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=0.5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
    return 0 if not running or proc.returncode in (0, -signal.SIGTERM) else 1


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: omaloom-devices list-microphones|list-webcams|check-camera DEVICE|meter [DEVICE]", file=sys.stderr)
        return 2
    if argv[1] == "list-microphones":
        return list_microphones()
    if argv[1] == "list-webcams":
        return list_webcams()
    if argv[1] == "check-camera":
        if len(argv) != 3:
            print("usage: omaloom-devices check-camera DEVICE", file=sys.stderr)
            return 2
        return check_camera(argv[2])
    if argv[1] == "meter":
        return meter(argv[2] if len(argv) > 2 else "default_input")
    print(f"unknown command: {argv[1]}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
