#!/usr/bin/python3
"""Compute and apply Omaloom webcam overlay placement."""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from typing import Any

POSITIONS = {"top-left", "top-right", "bottom-left", "bottom-right"}
SIZES = {"small", "medium", "large"}
MARGIN = 40
REGION_RE = re.compile(r"^region:(\d+)x(\d+)\+(-?\d+)\+(-?\d+)$")
ADDRESS_RE = re.compile(r"^0x[0-9a-fA-F]+$")


class PlacementError(RuntimeError):
    pass


def logical_monitor(m: dict[str, Any]) -> dict[str, Any]:
    scale = float(m.get("scale", 1) or 1)
    transform = int(m.get("transform", 0) or 0)
    rotated = transform % 2 == 1
    pw = int(m["width"])
    ph = int(m["height"])
    return {
        "id": int(m.get("id", -1)),
        "name": str(m.get("name", "")),
        "x": int(m["x"]),
        "y": int(m["y"]),
        "width": int((ph if rotated else pw) / scale),
        "height": int((pw if rotated else ph) / scale),
        "scale": scale,
        "transform": transform,
    }


def parse_region(target: str) -> dict[str, int] | None:
    match = REGION_RE.match(target)
    if not match:
        return None
    w, h, x, y = (int(v) for v in match.groups())
    return {"x": x, "y": y, "width": w, "height": h}


def intersect(a: dict[str, int], b: dict[str, Any]) -> dict[str, int] | None:
    left = max(a["x"], int(b["x"]))
    top = max(a["y"], int(b["y"]))
    right = min(a["x"] + a["width"], int(b["x"]) + int(b["width"]))
    bottom = min(a["y"] + a["height"], int(b["y"]) + int(b["height"]))
    if right <= left or bottom <= top:
        return None
    return {"x": left, "y": top, "width": right - left, "height": bottom - top}


def size_for(anchor: dict[str, int], size: str, margin: int = MARGIN) -> dict[str, int]:
    if size not in SIZES:
        raise PlacementError(f"invalid webcam size: {size}")
    scale_height = anchor["height"]
    available_width = anchor["width"] - 2 * margin
    if available_width > 0 and scale_height * 3 / 10 > available_width:
        scale_height = available_width * 10 // 3
    ratios = {"small": (9, 50), "medium": (1, 4), "large": (27, 80)}
    num, den = ratios[size]
    h = max(1, (scale_height * num + den // 2) // den)
    w = max(1, (h * 8 + 4) // 9)
    return {"width": w, "height": h}


def placement(anchor: dict[str, int], size: str, position: str, margin: int = MARGIN) -> dict[str, int]:
    if position not in POSITIONS:
        raise PlacementError(f"invalid webcam position: {position}")
    wh = size_for(anchor, size, margin)
    w = min(wh["width"], max(1, anchor["width"] - 2 * margin))
    h = min(wh["height"], max(1, anchor["height"] - 2 * margin))
    x = anchor["x"] + margin if position.endswith("left") else anchor["x"] + anchor["width"] - w - margin
    y = anchor["y"] + margin if position.startswith("top") else anchor["y"] + anchor["height"] - h - margin
    x = max(anchor["x"] + margin, min(x, anchor["x"] + anchor["width"] - w - margin))
    y = max(anchor["y"] + margin, min(y, anchor["y"] + anchor["height"] - h - margin))
    return {"x": x, "y": y, "width": w, "height": h}


def anchor_for(target: str, monitors: list[dict[str, Any]], monitor_id: int | None = None) -> dict[str, int]:
    logical = [logical_monitor(m) for m in monitors if not m.get("disabled")]
    region = parse_region(target)
    if region:
        hits = [hit for m in logical if (hit := intersect(region, m))]
        if hits:
            left = min(h["x"] for h in hits)
            top = min(h["y"] for h in hits)
            right = max(h["x"] + h["width"] for h in hits)
            bottom = max(h["y"] + h["height"] for h in hits)
            return {"x": left, "y": top, "width": right - left, "height": bottom - top}
        return region
    name = target.split(":", 1)[1] if target.startswith("monitor:") else ""
    if name:
        for m in logical:
            if m["name"] == name:
                return {"x": m["x"], "y": m["y"], "width": m["width"], "height": m["height"]}
    if monitor_id is not None:
        for m in logical:
            if m["id"] == monitor_id:
                return {"x": m["x"], "y": m["y"], "width": m["width"], "height": m["height"]}
    if logical:
        m = logical[0]
        return {"x": m["x"], "y": m["y"], "width": m["width"], "height": m["height"]}
    raise PlacementError("no monitors found")


def compute(target: str, monitors_json: str, size: str, position: str, monitor_id: int | None = None) -> dict[str, int]:
    monitors = json.loads(monitors_json)
    anchor = anchor_for(target, monitors, monitor_id)
    return placement(anchor, size, position)


def dispatch_window(address: str, rect: dict[str, int]) -> None:
    if not ADDRESS_RE.match(address):
        raise PlacementError("invalid webcam window address")
    window = "address:" + address
    commands = [
        (
            f'hl.dsp.window.resize({{ window = "{window}", x = {rect["width"]}, y = {rect["height"]} }})',
            "resizewindowpixel",
            f'exact {rect["width"]} {rect["height"]},{window}',
        ),
        (
            f'hl.dsp.window.move({{ window = "{window}", x = {rect["x"]}, y = {rect["y"]} }})',
            "movewindowpixel",
            f'exact {rect["x"]} {rect["y"]},{window}',
        ),
    ]
    for lua_command, legacy_dispatcher, legacy_argument in commands:
        result = subprocess.run(
            ["hyprctl", "dispatch", lua_command],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            continue
        result = subprocess.run(
            ["hyprctl", "dispatch", legacy_dispatcher, legacy_argument],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode != 0:
            raise PlacementError(f"failed to dispatch webcam {legacy_dispatcher}")


def apply(target: str, size: str, position: str) -> int:
    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
    client = next((c for c in clients if c.get("title") == "WebcamOverlay"), None)
    if not client:
        return 0
    monitors_json = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True)
    rect = compute(target, monitors_json, size, position, int(client.get("monitor", -1)))
    dispatch_window(str(client["address"]), rect)
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    c = sub.add_parser("compute")
    c.add_argument("--target", required=True)
    c.add_argument("--size", required=True, choices=sorted(SIZES))
    c.add_argument("--position", required=True, choices=sorted(POSITIONS))
    c.add_argument("--monitors-json", required=True)
    c.add_argument("--monitor-id", type=int)
    a = sub.add_parser("apply")
    a.add_argument("--target", required=True)
    a.add_argument("--size", required=True, choices=sorted(SIZES))
    a.add_argument("--position", required=True, choices=sorted(POSITIONS))
    args = parser.parse_args(argv[1:])
    try:
        if args.command == "compute":
            print(json.dumps(compute(args.target, args.monitors_json, args.size, args.position, args.monitor_id), sort_keys=True))
            return 0
        if args.command == "apply":
            return apply(args.target, args.size, args.position)
    except Exception as exc:
        print(json.dumps({"error": str(exc)}, sort_keys=True), file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
