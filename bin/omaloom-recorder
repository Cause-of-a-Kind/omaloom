#!/usr/bin/env bash
set -o pipefail

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/share/omarchy/bin"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DEFAULT_DIR="$HOME/Videos/Omaloom"
RECORDING_FILE="/tmp/omarchy-screenrecord-filename"
STATE_HELPER="$SCRIPT_DIR/omaloom-state"
OUTPUT_HELPER="$SCRIPT_DIR/omaloom-output"
RUNTIME_HELPER="$SCRIPT_DIR/omaloom-runtime"
STATE_RESERVED=false
STATE_RETAIN=false
OUTPUT_RESERVED=""
WEBCAM_PID=""
WEBCAM_RETAIN=false
WEBCAM_PID_FILE=""

runtime_dir() {
  [[ -x $RUNTIME_HELPER ]] || return 1
  "$RUNTIME_HELPER" select
}

RUNTIME_DIR=$(runtime_dir 2>/dev/null || true)
[[ -n $RUNTIME_DIR ]] && export XDG_RUNTIME_DIR="$RUNTIME_DIR"
REGION_FILE=$([[ -n $RUNTIME_DIR ]] && echo "$RUNTIME_DIR/omarchy-screenrecord-region" || echo "")
WEBCAM_PID_FILE=$([[ -n $RUNTIME_DIR ]] && echo "$RUNTIME_DIR/omaloom-webcam.pid" || echo "")
LOG_FILE=$([[ (${OMARCHY_SCREENRECORD_DEBUG:-false} == "true" || ${OMALOOM_PROFILE:-false} == "true") && -n $RUNTIME_DIR ]] && echo "$RUNTIME_DIR/omaloom-screenrecord.log" || echo "/dev/null")

profile() {
  [[ ${OMALOOM_PROFILE:-false} == "true" ]] || return 0
  local monotonic _
  read -r monotonic _ </proc/uptime || monotonic=$EPOCHREALTIME
  printf 'PROFILE\t%s\t%s\n' "$monotonic" "$1" >>"$LOG_FILE"
}

usage() {
  cat <<'USAGE'
Usage:
  omaloom-recorder start [--directory DIR] [--fullscreen] [--desktop-audio] [--microphone] [--microphone-device DEVICE] [--webcam] [--webcam-device DEVICE] [--webcam-position POS] [--webcam-size SIZE]
  omaloom-recorder stop
  omaloom-recorder status
USAGE
}

json_escape() {
  local value=${1-}
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "$value"
}

emit() {
  local event=$1
  local key=${2-}
  local value=${3-}
  if [[ -n $key ]]; then
    printf '{"event":"%s","%s":"%s"}\n' "$(json_escape "$event")" "$(json_escape "$key")" "$(json_escape "$value")"
  else
    printf '{"event":"%s"}\n' "$(json_escape "$event")"
  fi
}

emit_source_selected() {
  local target=$1
  local event=""
  if [[ -x "$SCRIPT_DIR/omaloom-geometry" ]]; then
    event=$("$SCRIPT_DIR/omaloom-geometry" source-selected "$target" 2>/dev/null || true)
  fi
  if [[ $event == \{* ]]; then
    printf '%s\n' "$event"
  else
    printf '{"event":"source_selected","target":"%s"}\n' "$(json_escape "$target")"
  fi
}

emit_recording_started() {
  local path=$1
  printf '{"event":"recording_started","path":"%s"}\n' "$(json_escape "$path")"
}

fail() {
  emit error message "$*"
  exit 1
}

state_reserve() {
  [[ -x $STATE_HELPER ]] || return 1
  "$STATE_HELPER" reserve "$RECORDING_FILE" "$1" || return 1
  STATE_RESERVED=true
  STATE_RETAIN=false
}

state_read() {
  [[ -x $STATE_HELPER ]] || return 1
  "$STATE_HELPER" read "$RECORDING_FILE"
}

state_remove_if_owned() {
  [[ -x $STATE_HELPER ]] || return 0
  "$STATE_HELPER" remove "$RECORDING_FILE" >/dev/null 2>&1 || true
}

output_reserve() {
  [[ -x $OUTPUT_HELPER ]] || return 1
  "$OUTPUT_HELPER" reserve "$1"
}

output_remove_if_owned() {
  [[ -n ${1-} && -x $OUTPUT_HELPER ]] || return 0
  "$OUTPUT_HELPER" remove "$1" >/dev/null 2>&1 || true
}

cleanup_start_on_exit() {
  if [[ $WEBCAM_RETAIN != true ]]; then
    cleanup_webcam
  fi
  if [[ $STATE_RESERVED == true && $STATE_RETAIN != true ]]; then
    state_remove_if_owned
  fi
  if [[ -n $OUTPUT_RESERVED && $STATE_RETAIN != true ]]; then
    output_remove_if_owned "$OUTPUT_RESERVED"
  fi
}

is_recording() {
  pgrep -u "$UID" -f '^gpu-screen-recorder' >/dev/null 2>&1
}

expand_dir() {
  local dir=$1
  case $dir in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${dir#~/}" ;;
    *) printf '%s\n' "$dir" ;;
  esac
}

default_resolution() {
  local width height
  read -r width height < <(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.width) \(.height)"')
  if ((width > 3840 || height > 2160)); then
    echo "3840x2160"
  else
    echo "0x0"
  fi
}

select_capture_target() {
  local fullscreen=$1
  local target

  if [[ $fullscreen == true ]]; then
    echo "monitor:$(omarchy-hyprland-monitor-focused)"
    return
  fi

  target=$(omarchy-capture-region smart --match-monitor) || return 1
  if [[ $target == monitor:* ]]; then
    echo "$target"
    return
  fi

  [[ $target =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1
  echo "region:${BASH_REMATCH[3]}x${BASH_REMATCH[4]}+${BASH_REMATCH[1]}+${BASH_REMATCH[2]}"
}

countdown() {
  local i
  for i in 5 4 3 2 1; do
    emit countdown seconds "$i"
    sleep 1
  done
}

cleanup_webcam() {
  if [[ -x $RUNTIME_HELPER && -n $WEBCAM_PID_FILE ]]; then
    "$RUNTIME_HELPER" signal-remove "$WEBCAM_PID_FILE" >/dev/null 2>&1 || true
    "$RUNTIME_HELPER" remove "$WEBCAM_PID_FILE" >/dev/null 2>&1 || true
  fi
  [[ -n $REGION_FILE ]] && rm -f "$REGION_FILE"
}

webcam_overlay_ready() {
  [[ -n $WEBCAM_PID ]] || return 1
  kill -0 "$WEBCAM_PID" 2>/dev/null || return 1
  hyprctl clients -j | jq -e 'any(.[]; .title == "WebcamOverlay")' >/dev/null 2>&1
}

microphone_available() {
  local requested=${1-}
  [[ -z $requested || $requested == default_input ]] && return 0
  pactl --format=json list sources 2>/dev/null \
    | jq -e --arg name "$requested" 'any(.[]; .name == $name and (.name | endswith(".monitor") | not))' >/dev/null 2>&1
}

start_webcam_overlay() {
  local target=${1-}
  local webcam_device=${2-}
  local webcam_size=${3:-medium}
  local webcam_position=${4:-bottom-right}

  cleanup_webcam

  if [[ -z $webcam_device || ! -e $webcam_device ]]; then
    webcam_device=$(omarchy-capture-webcam-list | sed -n '1s/[[:space:]].*//p')
  fi
  if [[ -z $webcam_device ]]; then
    emit error message "no webcam devices found"
    return 1
  fi

  # Direct V4L2 capture is normally exclusive. Give the setup preview a brief
  # chance to release the device, then fail clearly rather than launching a
  # mapped-but-empty mpv window when another application still owns it.
  if command -v fuser >/dev/null 2>&1; then
    local owner_waited=0
    local camera_busy=true
    while ((owner_waited < 20)); do
      if ! fuser "$webcam_device" >/dev/null 2>&1; then
        camera_busy=false
        break
      fi
      sleep 0.05
      owner_waited=$((owner_waited + 1))
    done
    if [[ $camera_busy == true ]]; then
      emit error message "camera is already in use by another application"
      return 1
    fi
  fi

  local preferred_resolutions=("640x360" "1280x720" "1920x1080")
  local capture_options="framerate=30"
  local available_formats=""
  available_formats=$(v4l2-ctl --list-formats-ext -d "$webcam_device" 2>/dev/null || true)

  local resolution
  for resolution in "${preferred_resolutions[@]}"; do
    if grep -q "$resolution" <<<"$available_formats"; then
      capture_options="video_size=$resolution,$capture_options"
      break
    fi
  done

  local webcam_log=""
  webcam_log=$(mktemp "$RUNTIME_DIR/omaloom-webcam.XXXXXX.log") || {
    emit error message "unable to create webcam startup log"
    return 1
  }
  chmod 600 "$webcam_log" 2>/dev/null || true

  mpv "av://v4l2:$webcam_device" \
    --profile=low-latency --untimed --no-cache \
    --demuxer-lavf-o="$capture_options" \
    '--vf=lavfi=[crop=ih*8/9:ih]' \
    --title="WebcamOverlay" --wayland-app-id="WebcamOverlay-$webcam_size" \
    --no-border --no-audio --no-osc --osd-level=0 \
    --msg-level=all=warn >"$webcam_log" 2>&1 &
  local webcam_pid=$!
  WEBCAM_PID="$webcam_pid"
  if [[ -x $RUNTIME_HELPER ]]; then
    if ! "$RUNTIME_HELPER" write-pid "$WEBCAM_PID_FILE" "$webcam_pid" >/dev/null 2>&1; then
      kill "$webcam_pid" 2>/dev/null || true
      rm -f "$webcam_log"
      emit error message "unable to track webcam overlay process"
      return 1
    fi
  fi

  local waited=0
  local mapped=false
  while ((waited < 40)); do
    if hyprctl clients -j | jq -e 'any(.[]; .title == "WebcamOverlay")' >/dev/null 2>&1; then
      mapped=true
      break
    fi
    if ! kill -0 "$webcam_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
    waited=$((waited + 1))
  done

  if [[ $mapped != true ]] || ! kill -0 "$webcam_pid" 2>/dev/null; then
    local message="unable to start webcam overlay"
    if [[ -x "$SCRIPT_DIR/omaloom-webcam-diagnose" ]]; then
      message=$("$SCRIPT_DIR/omaloom-webcam-diagnose" "$webcam_log" 2>/dev/null || printf '%s' "$message")
    fi
    kill "$webcam_pid" 2>/dev/null || true
    cleanup_webcam
    rm -f "$webcam_log"
    emit error message "$message"
    return 1
  fi

  [[ $target == region:* ]] && echo "${target#region:}" >"$REGION_FILE"
  # Omaloom placement already applies both the requested size and position.
  # Do not run Omarchy's bottom-right resize first: that produces a visible
  # double move before the configured placement is applied.
  if [[ -x "$SCRIPT_DIR/omaloom-webcam-placement" ]]; then
    "$SCRIPT_DIR/omaloom-webcam-placement" apply --target "$target" --size "$webcam_size" --position "$webcam_position" || true
  fi

  # Mapping plus process liveness is enough to begin the countdown. Its five
  # seconds provide the camera substantially more warm-up time than the old
  # unconditional one-second pre-countdown settle delay.
  if ! webcam_overlay_ready; then
    local message="unable to start webcam overlay"
    if [[ -x "$SCRIPT_DIR/omaloom-webcam-diagnose" ]]; then
      message=$("$SCRIPT_DIR/omaloom-webcam-diagnose" "$webcam_log" 2>/dev/null || printf '%s' "$message")
    fi
    kill "$webcam_pid" 2>/dev/null || true
    cleanup_webcam
    rm -f "$webcam_log"
    emit error message "$message"
    return 1
  fi

  rm -f "$webcam_log"
}

toggle_screenrecording_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
}

start_recording() {
  local directory=$DEFAULT_DIR
  local fullscreen=false
  local desktop_audio=false
  local microphone_audio=false
  local webcam=false
  local microphone_device=""
  local webcam_device=""
  local webcam_size="medium"
  local webcam_position="bottom-right"

  trap cleanup_start_on_exit EXIT
  trap 'cleanup_start_on_exit; exit 130' HUP INT TERM

  [[ -n $RUNTIME_DIR ]] || fail "no safe per-user runtime directory found"

  while (($#)); do
    case $1 in
      --directory)
        shift
        [[ $# -gt 0 ]] || fail "--directory requires a value"
        directory=$(expand_dir "$1")
        ;;
      --directory=*) directory=$(expand_dir "${1#*=}") ;;
      --fullscreen) fullscreen=true ;;
      --desktop-audio) desktop_audio=true ;;
      --microphone) microphone_audio=true ;;
      --microphone-device)
        shift
        [[ $# -gt 0 ]] || fail "--microphone-device requires a value"
        microphone_device=$1
        ;;
      --microphone-device=*) microphone_device=${1#*=} ;;
      --webcam) webcam=true ;;
      --webcam-device)
        shift
        [[ $# -gt 0 ]] || fail "--webcam-device requires a value"
        webcam_device=$1
        ;;
      --webcam-device=*) webcam_device=${1#*=} ;;
      --webcam-size)
        shift
        [[ $# -gt 0 ]] || fail "--webcam-size requires a value"
        webcam_size=$1
        ;;
      --webcam-size=*) webcam_size=${1#*=} ;;
      --webcam-position)
        shift
        [[ $# -gt 0 ]] || fail "--webcam-position requires a value"
        webcam_position=$1
        ;;
      --webcam-position=*) webcam_position=${1#*=} ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown start option: $1" ;;
    esac
    shift
  done

  case $webcam_size in small|medium|large) ;; *) fail "invalid webcam size: $webcam_size" ;; esac
  case $webcam_position in top-left|top-right|bottom-left|bottom-right) ;; *) fail "invalid webcam position: $webcam_position" ;; esac

  command -v gpu-screen-recorder >/dev/null 2>&1 || fail "gpu-screen-recorder command not found"
  command -v omarchy-capture-region >/dev/null 2>&1 || fail "omarchy-capture-region command not found"
  [[ -d $directory ]] || mkdir -p "$directory" || fail "could not create recording directory: $directory"

  if is_recording; then
    emit error message "screen recording is already active"
    exit 2
  fi

  local target
  if ! target=$(select_capture_target "$fullscreen"); then
    emit cancelled
    exit 3
  fi
  emit_source_selected "$target"
  profile source_selected
  local capture_args=()
  case $target in
    monitor:*) capture_args=(-w "${target#monitor:}" -s "$(default_resolution)") ;;
    region:*) capture_args=(-w "${target#region:}") ;;
    *) fail "unsupported capture target: $target" ;;
  esac

  # Complete filesystem and audio validation before camera placement and the
  # visible countdown. Once the camera reaches its requested corner, no file
  # preparation remains between that visual event and the first count.
  local audio_devices=""
  local audio_args=()
  if [[ $microphone_audio == true ]] && ! microphone_available "$microphone_device"; then
    emit warning message "selected microphone is unavailable; using default input"
    microphone_device=""
  fi
  [[ $desktop_audio == true ]] && audio_devices+="default_output"
  if [[ $microphone_audio == true ]]; then
    [[ -n $audio_devices ]] && audio_devices+="|"
    audio_devices+="${microphone_device:-default_input}"
  fi
  [[ -n $audio_devices ]] && audio_args+=(-a "$audio_devices" -ac aac)

  local filename=""
  if ! filename=$(output_reserve "$directory"); then
    cleanup_webcam
    fail "could not reserve secure recording output path"
  fi
  OUTPUT_RESERVED="$filename"

  if ! state_reserve "$filename"; then
    cleanup_webcam
    output_remove_if_owned "$filename"
    OUTPUT_RESERVED=""
    fail "could not reserve recording state file"
  fi
  profile recording_prepared

  # Prepare and place the real mpv webcam overlay before the visible countdown.
  # This keeps camera startup latency out of the gap between 1 and capture.
  if [[ $webcam == true ]]; then
    start_webcam_overlay "$target" "$webcam_device" "$webcam_size" "$webcam_position" || exit 1
  fi
  profile capture_devices_ready

  countdown
  profile countdown_complete
  # The countdown doubles as camera warm-up. Revalidate immediately before
  # capture so an overlay that failed during those five seconds is never
  # silently omitted from a recording that explicitly requested it.
  if [[ $webcam == true ]] && ! webcam_overlay_ready; then
    cleanup_webcam
    fail "webcam overlay stopped before recording began"
  fi
  emit starting
  # Allow Quickshell several frames to unmap the countdown before capture.
  sleep 0.12

  printf '===== %(%F %T)T omaloom target: %s =====\n' -1 "$target" >>"$LOG_FILE"
  gpu-screen-recorder "${capture_args[@]}" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -o "$filename" "${audio_args[@]}" 2>>"$LOG_FILE" &
  local pid=$!
  profile recorder_spawned

  # Treat either initial output or 200 ms of process survival as readiness.
  # Later failures remain observable through normal status polling instead of
  # imposing an unconditional 800 ms delay on every successful start.
  local readiness_checks=0
  while ((readiness_checks < 20)) && kill -0 "$pid" 2>/dev/null && [[ ! -s $filename ]]; do
    sleep 0.01
    readiness_checks=$((readiness_checks + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    profile recording_confirmed
    STATE_RETAIN=true
    WEBCAM_RETAIN=true
    OUTPUT_RESERVED=""
    toggle_screenrecording_indicator
    emit_recording_started "$filename"
  else
    cleanup_webcam
    state_remove_if_owned
    output_remove_if_owned "$filename"
    OUTPUT_RESERVED=""
    STATE_RESERVED=false
    fail "recording process exited before creating output"
  fi
}

stop_recording() {
  command -v omarchy >/dev/null 2>&1 || fail "omarchy command not found"

  if ! is_recording; then
    emit status state idle
    exit 0
  fi

  local output path
  if ! output=$(omarchy screenrecord --stop-recording 2>&1); then
    fail "${output:-failed to stop recording}"
  fi

  path=$(printf '%s\n' "$output" | awk 'NF { last=$0 } END { print last }')
  if [[ -n $path && -f $path ]]; then
    emit saved path "$path"
  else
    emit stopped
  fi
}

status_recording() {
  local path=""
  path=$(state_read 2>/dev/null || true)

  if is_recording; then
    if [[ -n $path ]]; then
      printf '{"event":"status","state":"recording","path":"%s"}\n' "$(json_escape "$path")"
    else
      printf '{"event":"status","state":"recording"}\n'
    fi
  else
    printf '{"event":"status","state":"idle"}\n'
  fi
}

case ${1-} in
  start) shift; start_recording "$@" ;;
  stop) shift; stop_recording "$@" ;;
  status) shift; [[ $# -eq 0 ]] || fail "status takes no arguments"; status_recording ;;
  -h|--help) usage ;;
  '') usage; exit 1 ;;
  *) fail "unknown command: $1" ;;
esac
